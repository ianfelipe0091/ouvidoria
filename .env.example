# Projeto Supabase — copie este arquivo para .env.local e preencha os valores.
# Encontre-os em: Supabase Dashboard > Project Settings > API Keys

# URL da API do projeto. Exposta ao browser.
NEXT_PUBLIC_SUPABASE_URL="https://SEU-PROJETO.supabase.co"

# Chave publicável (sb_publishable_...). Pode ser exposta ao browser — o acesso
# aos dados é controlado pelas políticas de RLS, não por esta chave.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# Chave secreta (sb_secret_...). Ignora RLS e dá acesso total ao banco.
# Opcional: só é necessária se você usar src/lib/supabase/admin.ts.
# NUNCA versione este valor nem use em Client Components.
SUPABASE_SECRET_KEY=""
